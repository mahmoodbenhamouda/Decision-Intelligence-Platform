# ── Variables d'environnement — Finance AI Agent ────────────────────────────
# Copier vers `.env` et remplir. NE JAMAIS committer `.env` (déjà ignoré).

# LLM (copilote / rédacteur de la flotte) — optionnel : replis déterministes sinon
GROQ_API_KEY=
# OPENAI_API_KEY=

# ── Authentification / RBAC ────────────────────────────────────────────────
# Base d'auth : PostgreSQL, OBLIGATOIRE. Il n'existe aucun repli — sans cette
# variable, ou avec une URL d'un autre moteur, l'API refuse de démarrer.
AUTH_DATABASE_URL=postgresql+psycopg2://finance:CHANGEME@localhost:5432/finance_auth

# La base de test est DÉDUITE de l'URL ci-dessus en suffixant « _test » : les
# identifiants ne sont déclarés qu'une fois. Création des deux bases :
#   python scripts/preparer_bases.py
# Les tests d'authentification sont SAUTÉS si elle est injoignable — jamais
# basculés sur un autre moteur.
# AUTH_TEST_DATABASE_URL=   # ne renseigner que pour viser un autre serveur

# Secret de signature des JWT — OBLIGATOIRE. L'API REFUSE DE DÉMARRER si cette
# variable est absente ou fait moins de 32 octets (RFC 7518 §3.2 : HS256 exige
# 256 bits). Aucun secret n'est généré à la volée : un secret tiré au démarrage
# diffère d'un worker à l'autre, donc un jeton émis par l'un est rejeté par les
# autres — des 401 intermittents et sans message.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Durée de vie des jetons (minutes) — défaut 480 (8 h)
JWT_EXPIRE_MINUTES=480

# Anti-brute-force
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# CORS : origines autorisées (frontend — le dev tourne sur le port 4000)
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4000,http://127.0.0.1:4000
