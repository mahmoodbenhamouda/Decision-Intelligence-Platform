# ── Variables d'environnement — Finance AI Agent ────────────────────────────
# Copier vers `.env` et remplir. NE JAMAIS committer `.env` (déjà ignoré).

# LLM (copilote / rédacteur de la flotte) — optionnel : replis déterministes sinon
GROQ_API_KEY=
# OPENAI_API_KEY=

# ── Authentification / RBAC ────────────────────────────────────────────────
# Base d'auth : PostgreSQL en production. Sans cette variable → repli SQLite
# (output/auth.db) pour la démo — schéma identique.
AUTH_DATABASE_URL=postgresql+psycopg2://finance:CHANGEME@localhost:5432/finance_auth

# Secret de signature des JWT — OBLIGATOIRE en production (48+ caractères aléatoires)
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Durée de vie des jetons (minutes) — défaut 480 (8 h)
JWT_EXPIRE_MINUTES=480

# Anti-brute-force
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# CORS : origines autorisées (frontend — le dev tourne sur le port 4000)
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4000,http://127.0.0.1:4000
